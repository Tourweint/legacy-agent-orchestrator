# 被测存量系统（mock-legacy）运行配置
#
# 设计原则：零侵入 —— 不向 mock-legacy 目录写入任何文件。
# 该项目的 spring.profiles.active=local 指向的 application-local.yaml 已被其 .gitignore 排除，
# 因此本地运行时全部配置通过「环境变量」注入（与它自带的 docker-compose.yaml 使用同一套变量名）。
#
# 用法：复制为 legacy.env 并按本机情况修改，然后由 deploy/scripts/start-legacy.sh 载入。
# 注意：不要提交任何真实密码 / 密钥。

# ---------- 数据库（本机为 MariaDB 12.1，协议兼容 MySQL 8） ----------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/classroom?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

# ---------- Redis（必需：未启动时登录后所有接口返回 401） ----------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ---------- 邮件（仅用于邮箱验证码注册/找回密码；口令登录不触发） ----------
# 竞赛演示使用口令登录，此处填占位值即可；JavaMailSender 仅在真正发送时才建立连接。
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=noreply@example.com
SPRING_MAIL_PASSWORD=placeholder
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
APP_MAIL_FROM=noreply@example.com

# ---------- 认证 ----------
JWT_SECRET=legacy-agent-orchestrator-local-secret
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
APP_AUTH_EMAIL_CODE_EXPIRATION_SECONDS=300
APP_AUTH_EMAIL_CODE_RESEND_SECONDS=60
APP_AUTH_MAX_DEVICE_SESSIONS=3

# ---------- JDK ----------
# 必须使用 JDK 17：本机 PATH 默认的 Java 24 与项目编译配置不兼容
JDK17_HOME=C:/Program Files/Microsoft/jdk-17.0.8.7-hotspot
